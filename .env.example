# ==============================================================================
# Macrow Digital HRMS - Backend Environment Configuration (Render / Local)
# ==============================================================================

# Server Runtime
PORT=3000
NODE_ENV=production
APP_TIMEZONE=Asia/Kolkata

# Public URL of the Frontend (e.g. your Hostinger domain)
# Used for invite links, reset links, and CORS whitelist
APP_BASE_URL=https://people.macrowdigital.com
CLIENT_ORIGIN=https://people.macrowdigital.com
CORS_ORIGINS=https://people.macrowdigital.com,http://localhost:5173,http://127.0.0.1:5173

# Set to true only if you need open CORS across all domains:
ALLOW_ALL_CORS=false

# 32-byte Base64 key for encrypting employee bank accounts & sensitive documents
HRMS_ENCRYPTION_KEY=ktnNazisVIrJYCOtibu3SFTuZxkjKPlhNOQuwOExZFs=

# Data directory for SQLite database file (Render persistent disk: /var/data or ./data)
HRMS_DATA_DIR=./data

# Initial Super Admin credentials (automatically seeded on first boot)
SUPER_ADMIN_EMAIL=admin@macrowdigital.com
SUPER_ADMIN_PASSWORD=ChangeThisPassword123!
SUPER_ADMIN_NAME=Macrow Admin
SYNC_ADMIN_CREDENTIALS=false

# Support & Contact
SUPPORT_EMAIL=support@macrowdigital.com

# SMTP Email Configuration (Hostinger / Titan / Google Workspace)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hr@macrowdigital.com
SMTP_PASS=YourEmailPasswordHere
SMTP_FROM=Macrow People <hr@macrowdigital.com>
